@startuml
skinparam dpi 200
' scale 13500 width
' scale 2200 height
title 涓流功能
state "涓流功能" as Login
state Login {
[*]  --> 充电运行
充电运行 : 1.判断电池电压\n2.判断涓流充电标志(true/false,默认false)
充电运行 --> 正常功率充电 : 电池电压 > 5.6V\n电池电压 < 7.2V
正常功率充电  : 涓流充电标志 = false
充电运行 --> 涓流充电 : 电池电压 < 5.6V\n电池电压 > 7.2V\n涓流充电标志 = true
state 涓流充电 {
    [*] --> 条件限制
    条件限制 : 1.最大充电功率60W\n2.最大电池充电电流为15A\n3.计算得出电池充电电流限制值
    条件限制 --> 充电限制 : 电池实际充电电流 > \n电池充电电流限制值
    充电限制 : 电池充电电流逐渐减小至限制值
    充电限制 --> 进行充电
    进行充电 : 维持电池充电电流在限制值
    进行充电 --> [*]
}
涓流充电 --> 退出涓流 : 电池电压 > 5.6V\n电池电压 < 7.2V
退出涓流 : 1.电压稳定在5.6V和7.2V之间10s，\n(维持10s是为了防止电压临界波动)\n2.涓流充电标志 = false\n3.电池充电电流逐渐增加 
退出涓流 --> 正常功率充电
' 退出涓流 --> [*]
正常功率充电 --> [*]
}

' 待机 :参数初始化
' 待机 --> 检测 : 待机模式 = 0（自动启机）
' 检测 : 检测故障码电池市电
' 检测 --> 状态机 : 无故障，电池无开路，\n无低压关输出告警，\n高压充电标志 = 0
' 状态机 : Load状态 = 2\n进入离网启机
' 状态机 --> ToBattery : 进入离网启机
' state ToBattery{
'     [*] --> 初始化
'     初始化:逆变控制器和DCDC控制器
'     初始化 --> IF
'     IF:Load状态机=0或\n电池开路或电池低压关输出
'     IF --> 返回待机态 : yes
'     IF --> 状态机ToBattery : no
'     状态机ToBattery --> 软起BUS : ToBattery = 0
'     软起BUS : 正常软起，\n超过60s则软起失败
'     软起BUS -->  故障态: 母线软起故障
'     软起BUS -->  逆变初始值: 软起成功\nToBattery = 1
'     逆变初始值 : 设置逆变初始值和状态\n1.初始值50V\n2.控制器设为离网
'     逆变初始值 --> 逆变软起 : ToBattery = 2
'     逆变软起 : 1.100V/s软起至设定值（230V）\n2.在过零点处吸合负载继电器\n3.软起超过10s
'     逆变软起 --> 故障态 : 逆变软起故障
'     逆变软起 --> 离网模式 : 软起成功
'     离网模式 : Battery模式
' }
' 离网模式 --> Battery : 软起成功
' ' ToBattery --> Battery : 软起成功
' state Battery{
'     [*] --> 逆变离网运行
' }
' Battery --> [*] : AC输出
@enduml