/'''''''''''''''''''''''''''''''''''''''''''''''''
'''''''''''''''''''''''''''按键逻辑''''''''''''''''
'''''''''''''''''''''''''''''''''''''''''''''''''/
@startuml
skinparam dpi 200
' scale 13500 width
' scale 2200 height
title 按键逻辑
state "按键逻辑" as Login
state Login {
    ' state 输出按键 as Key1
    ' state 绿电按键 as Key2
    state 输出按键 {
        [*] --> 关机态
        关机态 --> 按键开机 : 无PV无市电\n按下按键3s
        按键开机 : 1.亮显示屏\n2.进入自动启机程序
        按键开机 --> 逆变输出
        逆变输出 --> 按键关机 : 不存在PV和市电\n长按按键3s
        按键关机 --> 关机
        关机态 --> PV唤醒开机:PV存在>12V
        PV唤醒开机 : 1.3s后亮显示屏\n2.PV自动充电\n3.逆变不启机
        PV唤醒开机 --> 待机
        待机 : 1.PV充电\n2.等待按键开逆变输出
        待机 --> 逆变输出 : 按下按键3s\n进入逆变输出启机流程
        逆变输出 --> 返回待机 : 存在PV，无市电，\n长按按键3s
        返回待机 --> 关机 : 无PV，待机30s\n自动关机

        关机态 --> AC唤醒开机:市电存在>90V
        AC唤醒开机 : 1.亮显示屏\n2.进入自动启机程序
        AC唤醒开机 --> 市电充电
        市电充电 : 按键无法关机
        市电充电 --> 逆变输出 : 无市电

        关机 --> [*]
    }
    state 绿电按键 {
        [*] --> 绿电关闭
        绿电关闭 --> 开启绿电模式 : 按下按键1s\n进入绿电模式
        开启绿电模式 : 降逆变电压至180V
        开启绿电模式 --> 关闭绿电模式 : 按下按键1s\n退出绿电模式
        关闭绿电模式 : 恢复逆变电压额定值（230V）
        关闭绿电模式 --> [*]
    }
@enduml

