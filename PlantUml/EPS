@startuml
' skinparam dpi 200
title EPS切换流程
state "EPS切换逻辑" as Login
state Login {
' [*]  --> 待机 : 上电
state 离网且并网{
' state 非市电高压充电{
    [*] --> 离网运行
    ' 离网运行 : 1.离网运行\n2.市电高压充电
    离网运行 --> 检测市电 : 市电高压充电
    检测市电 : 1.市电无告警\n2.电池温度>0℃且<45℃
    检测市电 --> 市电正常充电 : 市电高压充电标志 = 0 
    检测市电 --> 市电高压充电 : 市电高压充电标志 = 1 
    state 市电正常充电{
        [*] --> ToLine状态
        ToLine状态 : 1.市电过零点处关闭逆变控制器
        ToLine状态 : 2.过零点处吸合市电继电器  
        ToLine状态 --> 市电充电模式 : 市电继电器吸合成功
        市电充电模式 : 延迟一个周期后，\n逆变控制器设为并网
        市电充电模式 --> [*] : AC充电
    }
    state 市电高压充电{
        [*] --> 过渡态
        过渡态 : 1.市电过零点处关闭逆变控制器
        ToChg状态 : 1.市电过零点处关闭逆变控制器
        ToChg状态 : 2.过零点处吸合市电继电器  
        ToChg状态 --> 市电高压充电模式 : 市电继电器吸合成功
        市电高压充电模式 : 延迟一个周期后，\n逆变控制器设为并网
        市电高压充电模式 --> [*] : AC充电
    }
' }
}
state 并网切离网{
    [*] --> 并网运行
    并网运行 : 非高压充电和高压充电同适用
    并网运行 --> 市电条件检测
    市电条件检测 : 市电丢失告警或\n市电过欠压过欠频告警
    市电条件检测 --> 切离网中间态 
    state 切离网中间态{
        [*] --> ToBattery状态
        state ToBattery状态{
            [*] --> 断开负载继电器和关闭逆变控制器
            断开负载继电器和关闭逆变控制器 --> 条件判断 
            条件判断 :电池开路告警\n且OP继电器闭合\n且推挽开启
            条件判断 --> 进入待机 : NO
            条件判断 --> 切离网过程 : Yes
            切离网过程 : 1.延时10ms设置逆变控制器为离网
            切离网过程 : 2.初始化逆变数据，从184V软起
            切离网过程 --> 离网输出运行 
        }
        ToBattery状态 --> 离网模式
        离网模式 : 输出运行
        离网模式 --> [*] : AC输出
    }
}
}
@enduml