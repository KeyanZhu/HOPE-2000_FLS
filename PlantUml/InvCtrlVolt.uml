@startuml
skinparam dpi 200
' scale 13500 width
' scale 2200 height
title 离网启动流程
state "离网启动流程" as Login
state Login {
[*]  --> 待机 : 上电
待机 :参数初始化
待机 --> 检测 : 待机模式 = 0（自动启机）
检测 : 检测故障码电池市电
检测 --> 状态机 : 无故障，电池无开路，\n无低压关输出告警，\n高压充电标志 = 0
状态机 : Load状态 = 2\n进入离网启机
状态机 --> ToBattery : 进入离网启机
state ToBattery{
    [*] --> 初始化
    初始化:逆变控制器和DCDC控制器
    初始化 --> IF
    IF:Load状态机=0或\n电池开路或电池低压关输出
    IF --> 返回待机态 : yes
    IF --> 状态机ToBattery : no
    状态机ToBattery --> 软起BUS : ToBattery = 0
    软起BUS : 正常软起，\n超过60s则软起失败
    软起BUS -->  故障态: 母线软起故障
    软起BUS -->  逆变初始值: 软起成功\nToBattery = 1
    逆变初始值 : 设置逆变初始值和状态\n1.初始值50V\n2.控制器设为离网
    逆变初始值 --> 逆变软起 : ToBattery = 2
    逆变软起 : 1.100V/s软起至设定值（230V）\n2.在过零点处吸合负载继电器\n3.软起超过10s
    逆变软起 --> 故障态 : 逆变软起故障
    逆变软起 --> 离网模式 : 软起成功
    离网模式 : Battery模式
}
离网模式 --> Battery : 软起成功
' ToBattery --> Battery : 软起成功
state Battery{
    [*] --> 逆变离网运行
}
Battery --> [*] : AC输出
@enduml