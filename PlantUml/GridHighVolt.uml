@startuml
' skinparam dpi 200
' scale 13500 width
' scale 2200 height
title 市电高压充电逻辑流程
state "市电高压充电逻辑流程" as Login
state Login {
[*]  --> 待机 : 上电
待机 :参数初始化
待机 --> 检测 : 待机模式 = 0（自动启机）
检测 : 检测故障码电池市电
检测 --> 状态机Load : 市电无告警，电池温度>0，\n且（市电高压标志 = 1或\n电池低压关输出告警 = 1）
状态机Load : Load状态 = 16\n进入高压充电启机
状态机Load --> ToChg : 进入高压充电启机
state ToChg{
    [*] --> 初始化
    初始化:关负载继电器，\n关闭推挽和逆变控制器
    初始化 --> IF
    IF:Load状态机= 16?
    IF --> 返回待机态 : no
    返回待机态 : 初始化参数
    IF --> 状态机ToChgMode : yes
    状态机ToChgMode : 初始化推挽、逆变控制器，\nOP继电器
    状态机ToChgMode  --> 闭合市电继电器 : ToChgMode  = 0
    闭合市电继电器 : 1.过零点闭合市电继电器
    闭合市电继电器 -->  闭合负载继电器: ToChgMode  = 1
    闭合负载继电器 --> 切逆变控制器 : ToChgMode  = 2
    切逆变控制器 : 逆变控制器设为并网控制
    切逆变控制器 --> 软起LLC : 等到母线电压稳定时\nToChgMode  = 3
    软起LLC : 1.ToChg模式充电标志 = 1 \n2. 进入高压充电LLC启机逻辑\n超过60s则软起失败
    软起LLC -->  故障态: 母线软起故障
    软起LLC --> 高压充电模式 : 软起成功
    高压充电模式 : Chg模式
}
高压充电模式 --> Chg模式 : 软起成功
state Chg模式{
    [*] --> 市电高压充电运行
}
Chg模式 --> [*] : AC充电

' state 市电高压充电标志{
'     [*] --> 市电高压充电标志 : 市电高压标志 = 1
'     市电高压充电标志 --> [*] : 市电高压标志 = 0
' }
}
@enduml